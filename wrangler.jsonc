{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "apexgym-backend",
    "main": "index.js",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "assets": {
        "directory": "./public",
        "binding": "ASSETS"
    }
}