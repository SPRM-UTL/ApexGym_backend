{
  "name": "backend",
  "version": "1.0.0",
  "description": "npx prisma migrate dev --name init",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "dev:cf": "wrangler dev",
    "test": "node --test tests/unit/notificacionesFcm.test.js tests/unit/notificacionesQr.test.js tests/unit/pedidosCompra.test.js && node tests/api/run.js",
    "test:api": "node tests/api/run.js",
    "postinstall": "prisma generate",
    "deploy": "prisma db push && npx wrangler deploy",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/config": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cookie-parse": "^0.4.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "currency.js": "^2.0.4",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.1",
    "mariadb": "^3.5.4",
    "multer": "^2.4.0",
    "multer-storage-cloudinary": "^4.0.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "prisma": "^7.10.0",
    "repomix": "^1.18.1"
  }
