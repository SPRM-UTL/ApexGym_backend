generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id              Int              @id @default(autoincrement())
  nombre          String           @db.VarChar(150)
  email           String           @unique @db.VarChar(191)
  contrasenia     String           @map("contrasenia") @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  tokens          Token[]
  usuarioRols     UsuarioRol[]
  usuarioPermisos UsuarioPermiso[]
  empleados       Empleado[]

  @@map("usuarios")
}

enum TipoToken {
  TOKEN_SESION
  RECUPERACION_CONTRASENIA
  VERIFICACION_CORREO
}

model Token {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tipoToken  TipoToken @map("tipo_token")
  token      String    @unique @db.VarChar(191)
  tiempoVida Int       @map("tiempo_vida")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Seccion {
  id             Int       @id @default(autoincrement())
  nombre         String    @unique @db.VarChar(100)
  descripcion    String?   @db.Text
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  modulos Modulo[]

  @@map("secciones")
}

model Modulo {
  id             Int       @id @default(autoincrement())
  seccionId      Int       @map("seccion_id")
  nombre         String    @db.VarChar(100)
  descripcion    String?   @db.Text
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  seccion  Seccion   @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  permisos Permiso[]

  @@unique([seccionId, nombre], name: "modulo_seccion_unico")
  @@map("modulos")
}

model AreaTrabajo {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  estado      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tiposActividad TipoActividad[]
  puestos        Puesto[]
  empleados      Empleado[]

  @@map("areas_trabajos")
}

model Caja {
  id        Int       @id @default(autoincrement())
  nombre    String    @db.VarChar(100)
  ubicacion String?   @db.VarChar(255)
  estado    String    @db.VarChar(30)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("cajas")
}

model Puesto {
  id            Int       @id @default(autoincrement())
  areaTrabajoId Int       @map("area_trabajo_id")
  nombre        String    @db.VarChar(100)
  descripcion   String?   @db.Text
  salarioBase   Decimal   @map("salario_base") @db.Decimal(10, 2)
  estado        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  areaTrabajo AreaTrabajo @relation(fields: [areaTrabajoId], references: [id], onDelete: Cascade)
  empleados   Empleado[]

  @@map("puestos")
}

model EstadoEmpleado {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empleados Empleado[]

  @@map("estados_empleados")
}

model Empleado {
  id               Int       @id @default(autoincrement())
  puestoId         Int       @map("puesto_id")
  areaTrabajoId    Int       @map("area_trabajo_id")
  estadoEmpleadoId Int       @map("estado_empleado_id")
  usuarioId        Int?      @map("usuario_id")
  nombre           String    @db.VarChar(100)
  apellidoPaterno  String    @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno  String?   @map("apellido_materno") @db.VarChar(100)
  telefono         String    @db.VarChar(20)
  correo           String?   @db.VarChar(191)
  direccion        String?   @db.Text
  fechaNacimiento  DateTime  @map("fecha_nacimiento")
  fechaIngreso     DateTime  @map("fecha_ingreso")
  imagenUrl        String?   @map("imagen_url") @db.LongText
  imagenPublicId   String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  puesto         Puesto         @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  areaTrabajo    AreaTrabajo    @relation(fields: [areaTrabajoId], references: [id], onDelete: Cascade)
  estadoEmpleado EstadoEmpleado @relation(fields: [estadoEmpleadoId], references: [id], onDelete: Cascade)
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@map("empleados")
}

model TipoActividad {
  id            Int       @id @default(autoincrement())
  areaTrabajoId Int?      @map("area_trabajo_id")
  nombre        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  estado        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  areaTrabajo AreaTrabajo? @relation(fields: [areaTrabajoId], references: [id], onDelete: SetNull)

  @@map("tipos_actividades")
}

model ConfiguracionSistema {
  id          Int       @id @default(autoincrement())
  clave       String    @unique @db.VarChar(100)
  valor       String    @db.Text
  tipoDato    String    @map("tipo_dato") @db.VarChar(30)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("configuraciones_sistema")
}

model Accion {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  permisos Permiso[]

  @@map("acciones")
}

enum MetodoHttp {
  GET
  POST
  PUT
  PATCH
  DELETE
  ALL
}

model Permiso {
  id          Int        @id @default(autoincrement())
  moduloId    Int        @map("modulo_id")
  accionId    Int        @map("accion_id")
  metodo      MetodoHttp
  descripcion String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  accion Accion @relation(fields: [accionId], references: [id], onDelete: Cascade)

  roles    RolPermiso[]
  usuarios UsuarioPermiso[]

  @@unique([moduloId, accionId, metodo], name: "permiso_unico")
  @@map("permisos")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@map("roles")
}

model RolPermiso {
  rolId     Int       @map("rol_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model UsuarioRol {
  usuarioId Int       @map("usuario_id")
  rolId     Int       @map("rol_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model UsuarioPermiso {
  usuarioId Int       @map("usuario_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@map("usuarios_permisos")
}
