generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Usuario {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(150)
  email       String    @unique
  contrasenia String    @map("contrasenia") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("usuarios")
}

model Token {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tipoToken  TipoToken @map("tipo_token")
  token      String    @unique
  tiempoVida Int       @map("tiempo_vida")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  @@index([usuarioId], map: "tokens_usuario_id_fkey")
  @@map("tokens")
}

model Seccion {
  id             Int       @id @default(autoincrement())
  nombre         String    @unique @db.VarChar(100)
  descripcion    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)

  @@map("secciones")
}

model Modulo {
  id             Int       @id @default(autoincrement())
  seccionId      Int       @map("seccion_id")
  nombre         String    @db.VarChar(100)
  descripcion    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)

  @@unique([seccionId, nombre], name: "modulo_seccion_unico")
  @@map("modulos")
}

model AreaTrabajo {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  estado      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("areas_trabajos")
}

model TipoActividad {
  id            Int       @id @default(autoincrement())
  areaTrabajoId Int?      @map("area_trabajo_id")
  nombre        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  estado        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  @@index([areaTrabajoId], map: "tipos_actividades_area_trabajo_id_fkey")
  @@map("tipos_actividades")
}

model ConfiguracionSistema {
  id          Int       @id @default(autoincrement())
  clave       String    @unique @db.VarChar(100)
  valor       String    @db.Text
  tipoDato    String    @map("tipo_dato") @db.VarChar(30)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("configuraciones_sistema")
}

model Accion {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("acciones")
}

model Permiso {
  id          Int        @id @default(autoincrement())
  moduloId    Int        @map("modulo_id")
  accionId    Int        @map("accion_id")
  metodo      MetodoHttp
  descripcion String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  @@unique([moduloId, accionId, metodo], name: "permiso_unico")
  @@index([accionId], map: "permisos_accion_id_fkey")
  @@map("permisos")
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("roles")
}

model RolPermiso {
  rolId     Int       @map("rol_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@id([rolId, permisoId])
  @@index([permisoId], map: "roles_permisos_permiso_id_fkey")
  @@map("roles_permisos")
}

model UsuarioRol {
  usuarioId Int       @map("usuario_id")
  rolId     Int       @map("rol_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@id([usuarioId, rolId])
  @@index([rolId], map: "usuarios_roles_rol_id_fkey")
  @@map("usuarios_roles")
}

model UsuarioPermiso {
  usuarioId Int       @map("usuario_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@id([usuarioId, permisoId])
  @@index([permisoId], map: "usuarios_permisos_permiso_id_fkey")
  @@map("usuarios_permisos")
}

model EstadoCliente {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  clientes Cliente[]

  @@map("estados_clientes")
}

model Cliente {
  id                         Int           @id @default(autoincrement())
  estadoClienteId            Int           @map("estado_cliente_id")
  nombre                     String        @db.VarChar(150)
  apellidoPaterno            String        @map("apellido_paterno") @db.VarChar(150)
  apellidoMaterno            String?       @map("apellido_materno") @db.VarChar(150)
  fechaNacimiento            DateTime      @map("fecha_nacimiento") @db.Date
  genero                     String        @db.VarChar(50)
  telefono                   String        @db.VarChar(20)
  correo                     String?       @db.VarChar(150)
  direccion                  String?       @db.Text
  contactoEmergenciaNombre   String?       @map("contacto_emergencia_nombre") @db.VarChar(150)
  contactoEmergenciaTelefono String?       @map("contacto_emergencia_telefono") @db.VarChar(20)
  fechaRegistro              DateTime      @map("fecha_registro") @db.Date
  createdAt                  DateTime      @default(now()) @map("created_at")
  updatedAt                  DateTime      @updatedAt @map("updated_at")
  deletedAt                  DateTime?     @map("deleted_at")

  estadoCliente EstadoCliente @relation(fields: [estadoClienteId], references: [id], onDelete: Restrict)

  @@map("clientes")
}

model EstadoMembresia {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("estados_membresias")
}

model TipoMembresia {
  id           Int       @id @default(autoincrement())
  nombre       String    @db.VarChar(150)
  descripcion  String?   @db.Text
  duracionDias Int       @map("duracion_dias")
  precio       Decimal   @db.Decimal(10, 2)
  estado       String    @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  @@map("tipos_membresias")
}

model TipoVisita {
  id          Int       @id @default(autoincrement())
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  costo       Decimal   @db.Decimal(10, 2)
  estado      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@map("tipos_visitas")
}

model CategoriaProducto {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  estado      String     @default("activo") @db.VarChar(30)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")
  productos   Producto[]

  @@map("categoria_productos")
}

enum MetodoHttp {
  GET
  POST
  PUT
  PATCH
  DELETE
  ALL
}

model Producto {
  id                  Int               @id @default(autoincrement())
  categoriaProductoId Int               @map("categoria_producto_id")
  codigoBarras        String?           @unique @map("codigo_barras") @db.VarChar(100)
  nombre              String            @db.VarChar(150)
  descripcion         String?           @db.Text
  precioVenta         Float             @map("precio_venta")
  precioCompra        Float?            @map("precio_compra")
  stockActual         Int               @default(0) @map("stock_actual")
  stockMinimo         Int               @default(1) @map("stock_minimo")
  estado              String            @default("activo") @db.VarChar(30)
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")
  
  categoria           CategoriaProducto @relation(fields: [categoriaProductoId], references: [id])

  @@map("producto")
}