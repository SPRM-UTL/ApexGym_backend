generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Empresa {
  id                Int       @id @default(autoincrement())
  nombreComercial   String    @map("nombre_comercial") @db.VarChar(150)
  razonSocial       String?   @map("razon_social") @db.VarChar(200)
  rfc               String?   @db.VarChar(20)
  telefono          String?   @db.VarChar(30)
  email             String?   @db.VarChar(191)
  direccion         String?   @db.Text
  ciudad            String?   @db.VarChar(100)
  estado            String?   @db.VarChar(100)
  codigoPostal      String?   @map("codigo_postal") @db.VarChar(20)
  logoUrl           String?   @map("logo_url") @db.LongText
  colorPrimario     String    @default("#FF6A00") @map("color_primario") @db.VarChar(20)
  moneda            String    @default("MXN") @db.VarChar(10)
  simboloMoneda     String    @default("$") @map("simbolo_moneda") @db.VarChar(10)
  zonaHoraria       String    @default("America/Mexico_City") @map("zona_horaria") @db.VarChar(100)
  toleranciaMinutos Int       @default(15) @map("tolerancia_minutos")
  mensajeTicket     String?   @map("mensaje_ticket") @db.Text
  activo            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  usuarios               Usuario[]
  roles                  Rol[]
  areasTrabajo           AreaTrabajo[]
  cajas                  Caja[]
  puestos                Puesto[]
  estadosEmpleados       EstadoEmpleado[]
  empleados              Empleado[]
  tiposActividad         TipoActividad[]
  configuracionesSistema ConfiguracionSistema[]
  estadosClientes        EstadoCliente[]
  clientes               Cliente[]
  clientesMembresias     ClienteMembresia[]
  estadosMembresias      EstadoMembresia[]
  tiposMembresias        TipoMembresia[]
  tiposVisitas           TipoVisita[]
  categoriasProductos    CategoriaProducto[]
  aperturasCaja          AperturaCaja[]
  movimientosCaja        MovimientoCaja[]
  cortesCaja             CorteCaja[]
  productos              Producto[]
  metodosPago            MetodoPago[]
  servicios              Servicio[]
  asistencias            Asistencia[]
  visitas                Visita[]
  transaccionesPagos     TransaccionPago[]

  @@map("empresas")
}

model Usuario {
  id              Int              @id @default(autoincrement())
  empresaId       Int              @default(1) @map("empresa_id")
  nombre          String           @db.VarChar(150)
  email           String           @unique @db.VarChar(191)
  contrasenia     String           @map("contrasenia") @db.VarChar(255)
  fotoUrl         String?          @map("foto_url") @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tokens          Token[]
  usuarioRols     UsuarioRol[]
  usuarioPermisos UsuarioPermiso[]
  empleados       Empleado[]
  cliente         Cliente?
  ventasRegistradas Venta[]

  @@map("usuarios")
}

enum TipoToken {
  TOKEN_SESION
  RECUPERACION_CONTRASENIA
  VERIFICACION_CORREO
}

model Token {
  id         Int       @id @default(autoincrement())
  usuarioId  Int       @map("usuario_id")
  tipoToken  TipoToken @map("tipo_token")
  token      String    @unique @db.VarChar(191)
  tiempoVida Int       @map("tiempo_vida")
  createdAt  DateTime  @default(now()) @map("created_at")
  deletedAt  DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("tokens")
}

model Seccion {
  id             Int       @id @default(autoincrement())
  nombre         String    @unique @db.VarChar(100)
  descripcion    String?   @db.Text
  orden          Int       @default(0)
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  modulos Modulo[]

  @@map("secciones")
}

model Modulo {
  id             Int       @id @default(autoincrement())
  seccionId      Int       @map("seccion_id")
  nombre         String    @db.VarChar(100)
  descripcion    String?   @db.Text
  orden          Int       @default(0)
  imagenUrl      String?   @map("imagen_url") @db.VarChar(500)
  imagenPublicId String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  seccion  Seccion   @relation(fields: [seccionId], references: [id], onDelete: Cascade)
  permisos Permiso[]

  @@unique([seccionId, nombre], name: "modulo_seccion_unico")
  @@map("modulos")
}

model AreaTrabajo {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  estado      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa        Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tiposActividad TipoActividad[]
  puestos        Puesto[]
  empleados      Empleado[]

  @@map("areas_trabajos")
}

model Caja {
  id        Int       @id @default(autoincrement())
  empresaId Int       @default(1) @map("empresa_id")
  nombre    String    @db.VarChar(100)
  ubicacion String?   @db.VarChar(255)
  estado    String    @db.VarChar(30)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  empresa       Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  aperturasCaja AperturaCaja[]

  @@map("cajas")
}

model Puesto {
  id            Int       @id @default(autoincrement())
  empresaId     Int       @default(1) @map("empresa_id")
  areaTrabajoId Int       @map("area_trabajo_id")
  nombre        String    @db.VarChar(100)
  descripcion   String?   @db.Text
  salarioBase   Decimal   @map("salario_base") @db.Decimal(10, 2)
  estado        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  areaTrabajo AreaTrabajo @relation(fields: [areaTrabajoId], references: [id], onDelete: Cascade)
  empleados   Empleado[]

  @@map("puestos")
}

model EstadoEmpleado {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  empleados Empleado[]

  @@map("estados_empleados")
}

model Empleado {
  id               Int       @id @default(autoincrement())
  empresaId        Int       @default(1) @map("empresa_id")
  puestoId         Int       @map("puesto_id")
  areaTrabajoId    Int       @map("area_trabajo_id")
  estadoEmpleadoId Int       @map("estado_empleado_id")
  usuarioId        Int?      @map("usuario_id")
  nombre           String    @db.VarChar(100)
  apellidoPaterno  String    @map("apellido_paterno") @db.VarChar(100)
  apellidoMaterno  String?   @map("apellido_materno") @db.VarChar(100)
  telefono         String    @db.VarChar(20)
  correo           String?   @db.VarChar(191)
  direccion        String?   @db.Text
  fechaNacimiento  DateTime  @map("fecha_nacimiento")
  fechaIngreso     DateTime  @map("fecha_ingreso")
  imagenUrl        String?   @map("imagen_url") @db.LongText
  imagenPublicId   String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  empresa        Empresa        @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  puesto         Puesto         @relation(fields: [puestoId], references: [id], onDelete: Cascade)
  areaTrabajo    AreaTrabajo    @relation(fields: [areaTrabajoId], references: [id], onDelete: Cascade)
  estadoEmpleado EstadoEmpleado @relation(fields: [estadoEmpleadoId], references: [id], onDelete: Cascade)
  usuario        Usuario?       @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  aperturasCaja   AperturaCaja[]
  movimientosCaja MovimientoCaja[]
  cortesCaja      CorteCaja[]
  ventas          Venta[]
  devoluciones    Devolucion[]

  @@map("empleados")
}

model TipoActividad {
  id            Int       @id @default(autoincrement())
  empresaId     Int       @default(1) @map("empresa_id")
  areaTrabajoId Int?      @map("area_trabajo_id")
  nombre        String    @db.VarChar(150)
  descripcion   String?   @db.Text
  estado        String    @db.VarChar(30)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  empresa     Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  areaTrabajo AreaTrabajo? @relation(fields: [areaTrabajoId], references: [id], onDelete: SetNull)

  @@map("tipos_actividades")
}

model ConfiguracionSistema {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  clave       String    @unique @db.VarChar(100)
  valor       String    @db.Text
  tipoDato    String    @map("tipo_dato") @db.VarChar(30)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("configuraciones_sistema")
}

model Accion {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique @db.VarChar(50)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  permisos Permiso[]

  @@map("acciones")
}

enum MetodoHttp {
  GET
  POST
  PUT
  PATCH
  DELETE
  ALL
}

model Permiso {
  id          Int        @id @default(autoincrement())
  moduloId    Int        @map("modulo_id")
  accionId    Int        @map("accion_id")
  metodo      MetodoHttp
  descripcion String?    @db.Text
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  modulo Modulo @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  accion Accion @relation(fields: [accionId], references: [id], onDelete: Cascade)

  roles    RolPermiso[]
  usuarios UsuarioPermiso[]

  @@unique([moduloId, accionId, metodo], name: "permiso_unico")
  @@map("permisos")
}

model Rol {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @unique @db.VarChar(100)
  descripcion String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa  Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  permisos RolPermiso[]
  usuarios UsuarioRol[]

  @@map("roles")
}

model RolPermiso {
  rolId     Int       @map("rol_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("roles_permisos")
}

model UsuarioRol {
  usuarioId Int       @map("usuario_id")
  rolId     Int       @map("rol_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([usuarioId, rolId])
  @@map("usuarios_roles")
}

model UsuarioPermiso {
  usuarioId Int       @map("usuario_id")
  permisoId Int       @map("permiso_id")
  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([usuarioId, permisoId])
  @@map("usuarios_permisos")
}

model EstadoCliente {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  color       String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clientes Cliente[]

  @@map("estados_clientes")
}

model Cliente {
  id                         Int       @id @default(autoincrement())
  empresaId                  Int       @default(1) @map("empresa_id")
  estadoClienteId            Int       @map("estado_cliente_id")
  nombre                     String    @db.VarChar(150)
  apellidoPaterno            String    @map("apellido_paterno") @db.VarChar(150)
  apellidoMaterno            String?   @map("apellido_materno") @db.VarChar(150)
  fechaNacimiento            DateTime  @map("fecha_nacimiento") @db.Date
  genero                     String    @db.VarChar(50)
  telefono                   String    @db.VarChar(20)
  correo                     String?   @db.VarChar(150)
  direccion                  String?   @db.Text
  contactoEmergenciaNombre   String?   @map("contacto_emergencia_nombre") @db.VarChar(150)
  contactoEmergenciaTelefono String?   @map("contacto_emergencia_telefono") @db.VarChar(20)
  fechaRegistro              DateTime  @map("fecha_registro") @db.Date
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  deletedAt                  DateTime? @map("deleted_at")

  usuarioId     Int?               @unique @map("usuario_id")
  empresa       Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  usuario       Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  estadoCliente EstadoCliente      @relation(fields: [estadoClienteId], references: [id], onDelete: Restrict)
  membresias    ClienteMembresia[]
  ventas        Venta[]
  asistencias   Asistencia[]  
  @@map("clientes")
}

model ClienteMembresia {
  id                   Int       @id @default(autoincrement())
  empresaId            Int       @default(1) @map("empresa_id")
  clienteId            Int       @map("cliente_id")
  tipoMembresiaId      Int       @map("tipo_membresia_id")
  estadoMembresiaId    Int       @map("estado_membresia_id")
  fechaInicio          DateTime  @map("fecha_inicio") @db.Date
  fechaFin             DateTime  @map("fecha_fin") @db.Date
  renovacionAutomatica Boolean   @default(false) @map("renovacion_automatica")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  deletedAt            DateTime? @map("deleted_at")

  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente         Cliente         @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  tipoMembresia   TipoMembresia   @relation(fields: [tipoMembresiaId], references: [id], onDelete: Restrict)
  estadoMembresia EstadoMembresia @relation(fields: [estadoMembresiaId], references: [id], onDelete: Restrict)
  detallesVenta   DetalleVenta[]
  asistencias     Asistencia[]    

  @@map("clientes_membresias")
}

model EstadoMembresia {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  color       String?   @db.VarChar(20)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clientesMembresias ClienteMembresia[]

  @@map("estados_membresias")
}

model TipoMembresia {
  id           Int       @id @default(autoincrement())
  empresaId    Int       @default(1) @map("empresa_id")
  nombre       String    @db.VarChar(150)
  descripcion  String?   @db.Text
  duracionDias Int       @map("duracion_dias")
  precio       Decimal   @db.Decimal(10, 2)
  estado       String    @db.VarChar(30)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  empresa            Empresa            @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  clientesMembresias ClienteMembresia[]
  detallesVenta DetalleVenta[]
  @@map("tipos_membresias")
}

model TipoVisita {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @db.VarChar(150)
  descripcion String?   @db.Text
  costo       Decimal   @db.Decimal(10, 2)
  estado      String    @db.VarChar(30)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  visitas Visita[]

  @@map("tipos_visitas")
}

model CategoriaProducto {
  id          Int        @id @default(autoincrement())
  empresaId   Int        @default(1) @map("empresa_id")
  nombre      String     @unique @db.VarChar(100)
  descripcion String?    @db.Text
  estado      String     @default("activo") @db.VarChar(30)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  empresa   Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  productos Producto[]

  @@map("categoria_productos")
}

model AperturaCaja {
  id             Int       @id @default(autoincrement())
  empresaId      Int       @default(1) @map("empresa_id")
  cajaId         Int       @map("caja_id")
  empleadoId     Int       @map("empleado_id")
  montoInicial   Decimal   @map("monto_inicial") @db.Decimal(10, 2)
  fechaApertura  DateTime  @map("fecha_apertura")
  estado         String    @default("ABIERTA") @db.VarChar(20)
  desgloseInicio String?   @map("desglose_inicio") @db.Text
  observaciones  String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  empresa  Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  caja     Caja     @relation(fields: [cajaId], references: [id], onDelete: Cascade)
  empleado Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  movimientos MovimientoCaja[]
  cortes      CorteCaja[]
  venta            Venta[]
  devoluciones     Devolucion[]

  @@map("aperturas_caja")
}

model MovimientoCaja {
  id             Int       @id @default(autoincrement())
  empresaId      Int       @default(1) @map("empresa_id")
  aperturaCajaId Int       @map("apertura_caja_id")
  empleadoId     Int       @map("empleado_id")
  tipo           String    @db.VarChar(20)
  monto          Decimal   @db.Decimal(10, 2)
  concepto       String    @db.VarChar(255)
  estado         String    @default("PENDIENTE") @db.VarChar(20)
  desglose       String?   @db.Text
  observaciones  String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  aperturaCaja AperturaCaja @relation(fields: [aperturaCajaId], references: [id], onDelete: Cascade)
  empleado     Empleado     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)
  devolucionId Int?          @unique @map("devolucion_id")
  devolucion   Devolucion?   @relation(fields: [devolucionId], references: [id], onDelete: Restrict)

  @@map("movimientos_caja")
}

model CorteCaja {
  id              Int       @id @default(autoincrement())
  empresaId           Int       @default(1) @map("empresa_id")
  aperturaCajaId  Int       @map("apertura_caja_id")
  empleadoId      Int       @map("empleado_id")
  efectivoContado Decimal   @map("efectivo_contado") @db.Decimal(10, 2)
  totalEntradas   Decimal   @default(0) @map("total_entradas") @db.Decimal(10, 2)
  totalSalidas    Decimal   @default(0) @map("total_salidas") @db.Decimal(10, 2)
  totalVentas     Decimal?  @map("total_ventas") @db.Decimal(10, 2)
  totalVentasEfectivo Decimal? @map("total_ventas_efectivo") @db.Decimal(10, 2)
  totalVentasCanceladas Decimal? @map("total_ventas_canceladas") @db.Decimal(10, 2)
  totalDevoluciones Decimal? @map("total_devoluciones") @db.Decimal(10, 2)
  efectivoEsperado Decimal? @map("efectivo_esperado") @db.Decimal(10, 2)
  diferencia      Decimal   @db.Decimal(10, 2)
  estado          String    @default("PENDIENTE") @db.VarChar(20)
  desgloseInicio  String?   @map("desglose_inicio") @db.Text
  desgloseFin     String?   @map("desglose_fin") @db.Text
  fechaValidacion DateTime? @map("fecha_validacion")
  observaciones   String?   @db.Text
  fechaCorte      DateTime  @default(now()) @map("fecha_corte")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  aperturaCaja AperturaCaja @relation(fields: [aperturaCajaId], references: [id], onDelete: Cascade)
  empleado     Empleado     @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@map("cortes_caja")
}

model Producto {
  id                  Int       @id @default(autoincrement())
  empresaId           Int       @default(1) @map("empresa_id")
  categoriaProductoId Int       @map("categoria_producto_id")
  codigoBarras        String?   @unique @map("codigo_barras") @db.VarChar(100)
  nombre              String    @db.VarChar(150)
  descripcion         String?   @db.Text
  precioVenta         Float     @map("precio_venta")
  descuentoPorcentaje Decimal  @default(0) @map("descuento_porcentaje") @db.Decimal(5, 2)
  precioCompra        Float?    @map("precio_compra")
  stockActual         Int       @default(0) @map("stock_actual")
  stockMinimo         Int       @default(1) @map("stock_minimo")
  estado              String    @default("activo") @db.VarChar(30)
  imagenUrl           String?   @map("imagen_url") @db.LongText
  imagenPublicId      String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")
  disponibleCompra    Boolean   @default(false) @map("disponible_compra")

  empresa   Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  categoria CategoriaProducto @relation(fields: [categoriaProductoId], references: [id])
  detallesVenta       DetalleVenta[]
  @@map("producto")
}

model FolioVenta {
  id                  Int             @id @default(autoincrement())
  venta               Venta?
}
/*Se añadio el modelado del punto de venta con apertura de caja por ahora se necesita revisar lo de carrito*/
model Venta {
  id                  Int               @id @default(autoincrement())
  empleadoId          Int               @map("empleado_id")
  clienteId           Int               @map("cliente_id")
  usuarioId           Int?              @map("usuario_id")
  folioVentaId        Int               @unique @map("folio_venta_id")
  aperturaCajaId      Int?              @map("apertura_caja_id")
  metodoPagoId        Int?              @map("metodo_pago_id")
  total               Float
  montoRecibido       Float?            @map("monto_recibido")
  cambio              Float?
  subtotal            Float             @default(0)
  descuento           Float             @default(0)
  metodoPagoLegacy    String            @default("efectivo") @map("metodo_pago") @db.VarChar(30)
  estado              String            @default("completado") @db.VarChar(30)
  motivoCancelacion   String?           @map("motivo_cancelacion") @db.VarChar(500)
  
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt() @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")

  aperturaCaja        AperturaCaja?     @relation(fields: [aperturaCajaId], references: [id])
  empleado            Empleado          @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  cliente             Cliente           @relation(fields: [clienteId], references: [id])
  usuario             Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  metodoPago          MetodoPago?       @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict)
  folioVenta          FolioVenta        @relation(fields: [folioVentaId], references: [id])
  detalleVenta        DetalleVenta[]
  devoluciones       Devolucion[]

  @@index([empleadoId])
  @@index([usuarioId])
  @@index([metodoPagoId])
  @@index([clienteId])
  @@map("venta")
}

model DetalleVenta {
  id               Int            @id @default(autoincrement())
  ventaId          Int            @map("venta_id")
  tipoItem         TipoItem       @default(PRODUCTO) @map("tipo_item")

  productoId       Int?           @map("producto_id")
  servicioId       Int?           @map("servicio_id")
  tipoMembresiaId  Int?           @map("tipo_membresia_id")

  clienteMembresiaId Int?         @unique @map("cliente_membresia_id")

  descripcion      String?        @db.VarChar(200) 
  cantidad         Int            @default(1)
  precioUnitario   Float          @map("precio_unitario")
  descuentoUnitario Decimal       @default(0) @map("descuento_unitario") @db.Decimal(10, 2)
  subtotal         Float

  venta            Venta              @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto         Producto?          @relation(fields: [productoId], references: [id])
  servicio         Servicio?          @relation(fields: [servicioId], references: [id])
  tipoMembresia    TipoMembresia?     @relation(fields: [tipoMembresiaId], references: [id])
  clienteMembresia ClienteMembresia?  @relation(fields: [clienteMembresiaId], references: [id])
  devoluciones    DevolucionDetalle[]

  @@map("detalle_venta")
}
model MetodoPago {
  id          Int       @id @default(autoincrement())
  empresaId   Int       @default(1) @map("empresa_id")
  nombre      String    @unique @db.VarChar(30)
  codigo      String?   @unique @db.VarChar(30)
  descripcion String?   @db.VarChar(200)
  estado      String    @default("activo") @db.VarChar(50)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ventas      Venta[]
  devoluciones Devolucion[]
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@map("metodo_pago")
}

model Servicio {
  id               Int       @id @default(autoincrement())
  empresaId        Int       @default(1) @map("empresa_id")
  nombre           String    @unique @db.VarChar(100)
  descripcion      String?   @db.VarChar(200)
  precio           Decimal   @default(0) @db.Decimal(10, 2)
  estado           String    @default("activo") @db.VarChar(50)
  disponibleCompra Boolean   @default(false) @map("disponible_compra")
  imagenUrl        String?   @map("imagen_url") @db.LongText
  imagenPublicId   String?   @map("imagen_public_id") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  detallesVenta       DetalleVenta[]
  @@map("servicios")
}

enum TipoItem {
  PRODUCTO
  SERVICIO
  MEMBRESIA
}
enum EstadoTransaccionPago {
  PENDIENTE
  APROBADO
  RECHAZADO
  EXPIRADO
  REEMBOLSADO
}

enum ProveedorPago {
  SANDBOX_SIMULADO
  MERCADO_PAGO
  PAYPAL
  STRIPE
  TERMINAL_MANUAL
  EFECTIVO
}

model TransaccionPago {
  id                Int                   @id @default(autoincrement())
  empresaId         Int                   @default(1) @map("empresa_id")
  uuidIdempotencia  String                @unique @map("uuid_idempotencia") @db.VarChar(100)
  proveedor         ProveedorPago         @default(SANDBOX_SIMULADO)
  referenciaExterna String?               @map("referencia_externa") @db.VarChar(150)
  monto             Decimal               @db.Decimal(10, 2)
  moneda            String                @default("MXN") @db.VarChar(10)
  estado            EstadoTransaccionPago @default(PENDIENTE)
  concepto          String                @db.VarChar(255)
  correoCliente     String?               @map("correo_cliente") @db.VarChar(191)
  datosRespuesta    String?               @map("datos_respuesta") @db.Text
  urlCheckout       String?               @map("url_checkout") @db.VarChar(500)
  folioVoucher      String?               @map("folio_voucher") @db.VarChar(100)
  metadatos         Json?
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  deletedAt         DateTime?             @map("deleted_at")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([empresaId, estado])
  @@map("transacciones_pagos")
}

model Asistencia {
  id                 Int       @id @default(autoincrement())
  empresaId          Int       @default(1) @map("empresa_id")
  clienteId          Int       @map("cliente_id")
  clienteMembresiaId Int?      @map("cliente_membresia_id")
  fechaHora          DateTime  @default(now()) @map("fecha_hora")
  observaciones      String?   @db.Text
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  empresa          Empresa           @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  cliente          Cliente           @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteMembresia ClienteMembresia? @relation(fields: [clienteMembresiaId], references: [id], onDelete: SetNull)

  @@map("asistencias")
}

model Visita {
  id              Int       @id @default(autoincrement())
  empresaId       Int       @default(1) @map("empresa_id")
  nombreVisitante String    @map("nombre_visitante") @db.VarChar(150)
  tipoVisitaId    Int       @map("tipo_visita_id")
  costo           Decimal   @db.Decimal(10, 2)
  fechaHora       DateTime  @default(now()) @map("fecha_hora")
  observaciones   String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict)
  tipoVisita TipoVisita @relation(fields: [tipoVisitaId], references: [id], onDelete: Restrict)

  @@map("visitas")
}


model Devolucion {
  id             Int      @id @default(autoincrement())
  ventaId        Int      @map("venta_id")
  aperturaCajaId Int      @map("apertura_caja_id")
  empleadoId     Int      @map("empleado_id")
  metodoPagoId   Int      @map("metodo_pago_id")
  monto          Decimal  @db.Decimal(10, 2)
  motivo         String   @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  venta          Venta          @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  aperturaCaja   AperturaCaja   @relation(fields: [aperturaCajaId], references: [id], onDelete: Restrict)
  empleado       Empleado       @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  metodoPago     MetodoPago     @relation(fields: [metodoPagoId], references: [id], onDelete: Restrict)
  detalles       DevolucionDetalle[]
  movimientoCaja MovimientoCaja?

  @@index([ventaId])
  @@index([aperturaCajaId])
  @@index([empleadoId])
  @@index([metodoPagoId])
  @@map("devoluciones")
}

model DevolucionDetalle {
  id               Int      @id @default(autoincrement())
  devolucionId     Int      @map("devolucion_id")
  detalleVentaId   Int      @map("detalle_venta_id")
  cantidad         Int
  monto            Decimal  @db.Decimal(10, 2)
  regresaAStock    Boolean  @default(false) @map("regresa_a_stock")

  devolucion   Devolucion   @relation(fields: [devolucionId], references: [id], onDelete: Restrict)
  detalleVenta DetalleVenta @relation(fields: [detalleVentaId], references: [id], onDelete: Restrict)

  @@index([devolucionId])
  @@index([detalleVentaId])
  @@map("devolucion_detalle")
}
